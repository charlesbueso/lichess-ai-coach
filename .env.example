# Lichess
LICHESS_USERNAME=your_lichess_username
# Optional: only needed for higher rate limits or private data
LICHESS_TOKEN=

# Groq
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.1-8b-instant

# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=123456789012345678

# Polling
POLL_INTERVAL_MINUTES=10

# Weekly analysis (cron-ish: day of week 0=Mon..6=Sun, hour 0-23 local time)
WEEKLY_DAY=6
WEEKLY_HOUR=18

# Storage
DB_PATH=data.db
