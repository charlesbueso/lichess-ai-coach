# --- Database (Postgres on the same droplet) ---
DATABASE_URL=postgresql://coach:CHANGEME@127.0.0.1:5432/coach

# --- Discord (one shared bot application) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_PUBLIC_KEY=     # only needed for HTTP interactions; we use the gateway

# --- Lichess (shared, optional but raises rate limits) ---
# LICHESS_TOKEN=
LICHESS_CONTACT=you@example.com

# --- LLM ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# --- Web ---
BASE_URL=https://chesscoach.gg
SESSION_SECRET=generate_a_random_32_plus_char_string_here
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# --- Limits ---
GAMES_PER_DAY_PER_TENANT=20
ASKS_PER_GAME=10
POLL_INTERVAL_MINUTES=10

# --- Observability ---
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Brand ---
APP_NAME=Lichess AI Coach
SUPPORT_EMAIL=support@chesscoach.gg

# --- Email (Resend) ---
# Leave RESEND_API_KEY blank in dev to disable sending (logs only).
# EMAIL_FROM domain MUST be verified in Resend (Domains → Verified).
RESEND_API_KEY=
EMAIL_FROM=Chess Brain Coach <noreply@matra.live>
EMAIL_REPLY_TO=support@chesscoach.gg

# --- Required by the OSS modules we re-use ---
# These can be dummy values in SaaS mode (they're used only by the legacy single-tenant entry point).
LICHESS_USERNAME=__saas__
DISCORD_CHANNEL_ID=0
