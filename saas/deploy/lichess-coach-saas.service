[Unit]
Description=Lichess AI Coach (SaaS)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=coach
Group=coach
WorkingDirectory=/opt/lichess-ai-coach
EnvironmentFile=/etc/coach.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lichess-ai-coach/.venv/bin/python -m saas.main
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/lichess-ai-coach
LimitNOFILE=65536

# RAM safety net for the 1 GB droplet: if the python process + stockfish
# engines blow past 800 MB, systemd OOM-kills only us (Postgres + Caddy
# stay alive) and `Restart=always` brings us back.
MemoryMax=800M
MemoryHigh=700M

[Install]
WantedBy=multi-user.target
